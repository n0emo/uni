\-\- resources/migrations/006-student-marks.up.sql

create table mark\_kinds(

name text primary key not null,

title text not null,

unique(title)

);

insert into mark\_kinds(name, title) values

\(\'credit\', \'Зачёт\'),

\(\'exam\', \'Экзамен\'),

