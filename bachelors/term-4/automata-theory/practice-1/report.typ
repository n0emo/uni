    [$x_1$], [$q_4$], [$q_3$], [$q_2$],
    [$x_2$], [$q_3$], [$q_2$], [$q_1$],
  ),
)

#figure(
  caption: [Таблица выходов $lambda : Q times X arrow.r Y$],
  table(
