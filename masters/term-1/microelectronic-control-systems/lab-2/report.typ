    [Логический уровень SA1--SA4], [DD2: A1--A4], [Слагаемое A],
    [Логический уровень SA5--SA8], [DD2: B1--B4], [Слагаемое B],
    [Логический уровень SA9], [DD2: Pin], [Входной перенос],
