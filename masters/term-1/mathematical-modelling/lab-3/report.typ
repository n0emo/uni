    [*Величина*], [*Состояние*], [*Расчёт*], [*ngspice*],
    table.cell(rowspan: 2)[Ток $I$, мА],
    [Включён], [#num(i-on-calc * 1000, d: 3)], [#num(-i-on * 1000, d: 3)],
    [Выключен], [#num(i-off-calc * 1000, d: 3)], [#num(-i-off * 1000, d: 3)],
    table.cell(rowspan: 2)[Напряжение $U_(R_2)$, В],
