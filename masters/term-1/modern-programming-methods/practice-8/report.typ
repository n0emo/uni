#let gantt(tasks, from: "2026-10-05", weeks: 11, today: "2026-10-18") = {
  let t0 = parse-date(from)
  let days = weeks * 7
  let offset(d) = (parse-date(d) - t0).days()
  let height = 1.5em
  let lane(body) = box(width: 100%, height: height, body)
  let label(body) = box(height: height, align(left + horizon, body))
  let grid-lines = for w in range(1, weeks) {
    place(dx: w / weeks * 100%, line(length: height, angle: 90deg, stroke: 0.3pt + luma(200)))
  }
  let today-line = place(
    dx: offset(today) / days * 100%,
    line(length: height, angle: 90deg, stroke: 0.8pt + red),
  )
  let header = lane(for w in range(weeks) {
    place(dx: w / weeks * 100% + 1pt, horizon, (t0 + duration(weeks: w)).display("[day].[month]"))
  })
  let rows = ()
  for (key, ms) in milestones {
    let group = tasks.filter(t => t.milestone == key)
    rows.push(grid.cell(colspan: 2, label(strong(ms.name))))
    for t in group {
      let start = offset(t.start)
      let end = offset(t.end) + 1
      rows.push(label(t.title))
      rows.push(lane({
        grid-lines
        place(
          dx: start / days * 100%,
          horizon,
          rect(width: (end - start) / days * 100%, height: 60%, fill: ms.color, stroke: none),
        )
        today-line
      }))
    }
  }
  set text(size: 7pt, hyphenate: false)
  set par(justify: false, leading: 0.4em, first-line-indent: 0pt)
  set align(left)
  grid(
    columns: (6.2cm, 1fr),
    stroke: (x, y) => if y > 0 { (bottom: 0.3pt + luma(220)) },
    inset: (x: 2pt, y: 0pt),
    grid.header([], header),
    ..rows,
  )
}

== Цель работы

Научиться эффективно планировать проект разработки ПО.

== Задачи

1. На основе задания или выбранного проекта разработать детальный план проекта с использованием
  диаграмм Ганта.
2. Определить основные этапы, сроки выполнения и распределение ресурсов.
3. Использовать инструмент управления проектами (например, Microsoft Project или Jira) для
  мониторинга и контроля выполнения задач.
4. В процессе работы команды вносить корректировки в план с учетом возникающих проблем и новых
  требований.
5. Подготовить отчет с планом проекта, результатами и анализом эффективности управления проектом.

== Ход работы

=== Объект планирования

Планировалось развитие собственного проекта baursak --- запускатора задач, в котором задачи
описываются на Lua (аналог make, just или mise tasks). Программа написана на Rust с библиотекой
mlua; задачи бывают shell-командами или функциями на Lua, принимают аргументы и зависят друг от
друга, независимые зависимости выполняются параллельно. Исходный код открыт на GitHub, проверка
сборки, тестов и линтера выполняется в GitHub Actions.

На момент планирования (18.10.2026) проект находился в состоянии прототипа: за 8--10 октября сделано
6 коммитов, около 900 строк на Rust, реализованы ядро, встроенные функции, поиск конфигурации в
родительских каталогах и обработка ошибок. Исходными данными для плана стали файлы репозитория
`ROADMAP.md` (разделы «Сделано», «Ближайшее» и «Будущее», всего 7 выполненных и 32 запланированных
пункта) и `CHANGELOG.md`, а также история коммитов.

=== Инструмент управления проектом

В качестве инструмента использовалась Vikunja 2.7 --- открытая система управления задачами,
развёрнутая на собственном сервере. Для проекта создан отдельный проект Vikunja «Baursak» с четырьмя
представлениями: список, диаграмма Ганта, таблица и канбан-доска. Каждая задача содержит даты начала
и окончания, срок, приоритет (1--4) и оценку трудоёмкости в часах; принадлежность к этапу задаётся
меткой. Выполненные задачи прототипа внесены с фактическими датами по истории коммитов и отмечены
как завершённые. Задачи создавались и выгружались через REST API Vikunja, из выгрузки построена
сводная диаграмма Ганта (рисунок 1).

=== Этапы и сроки

Пункты дорожной карты сгруппированы в этапы-выпуски по три недели (таблица 1). Внутри этапа задачи
упорядочены по зависимостям и приоритету, этап завершается задачей выпуска: обновление
`CHANGELOG.md`, тег версии, публикация.

