<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/Settings.fs" />
    <Compile Include="src/Model.fs" />
    <Compile Include="src/Store.fs" />
    <Compile Include="src/Migrations.fs" />
    <Compile Include="src/Responses.fs" />
    <Compile Include="src/Requests.fs" />
    <Compile Include="src/Pages.fs" />
    <Compile Include="src/Routes.fs" />
    <Compile Include="src/Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="migrations/*.sql" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="dbup-postgresql" Version="7.0.1" />
    <PackageReference Include="Donald" Version="10.1.0" />
    <PackageReference Include="Falco" Version="5.2.0" />
    <PackageReference Include="Falco.Htmx" Version="1.2.0" />
    <PackageReference Include="Falco.OpenApi" Version="1.2.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

</Project>
